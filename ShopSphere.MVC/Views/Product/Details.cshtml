@model ShopSphere.MVC.Models.ProductViewModel

@{
    ViewData["Title"] = Model.Name;
    var mainImage = !string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "https://plus.unsplash.com/premium_photo-1679513691474-73102089c117?q=80&w=800&auto=format&fit=crop";
}

<div class="row mt-4 mb-5 animate-slide-up">
    <!-- Gallery Section -->
    <div class="col-lg-6 mb-4 mb-lg-0">
        <div class="card card-modern border-0 overflow-hidden mb-3 position-relative" style="height: 500px; background-color: rgba(255,255,255,0.02)">
            <!-- Simulating Zoom over Cover -->
            <img src="@mainImage" class="w-100 h-100 object-fit-cover" style="transition: transform 0.3s; cursor: crosshair;" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'" id="mainProdImg" alt="@Model.Name">
            <span class="badge bg-danger position-absolute top-0 start-0 m-4 fs-6">🔥 Top Seller</span>
        </div>
        <div class="row g-2">
            @{
                var gallery = new[] {
                    "https://plus.unsplash.com/premium_photo-1679513691474-73102089c117?q=80&w=800&auto=format&fit=crop",
                    "https://images.unsplash.com/photo-1546868871-7041f2a55e12?q=80&w=800&auto=format&fit=crop",
                    "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?q=80&w=800&auto=format&fit=crop",
                    "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?q=80&w=800&auto=format&fit=crop"
                };
            }
            @for (int i = 0; i < 4; i++)
            {
                <div class="col-3">
                    <div class="card card-modern border-0 overflow-hidden" style="height: 100px; cursor: pointer;" onclick="document.getElementById('mainProdImg').src='@gallery[i]'">
                         <img src="@gallery[i]" class="w-100 h-100 object-fit-cover opacity-75 hover-opacity-100 transition-opacity">
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Details Section -->
    <div class="col-lg-6 ps-lg-5 d-flex flex-column">
        <div class="mb-2">
            <span class="badge bg-secondary opacity-75 text-uppercase letter-spacing-1">@(Model.Category?.Name ?? "Premium Electronics")</span>
            <div class="float-end text-warning fw-bold fs-5"><i class="fa-solid fa-star"></i> 4.9 <span class="text-muted small fw-normal">(1,024 Reviews)</span></div>
        </div>
        <h1 class="display-5 fw-bold mb-3 text-gradient">@Model.Name</h1>
        <h2 class="fw-bold text-success mb-4">$@Model.Price.ToString("F2")</h2>
        
        <p class="lead text-muted mb-4 opacity-75">@(!string.IsNullOrEmpty(Model.Description) ? Model.Description : "A beautifully crafted piece of tech designed to revolutionize your daily life.")</p>
        
        <div class="mb-4">
            <span class="badge bg-success bg-opacity-25 text-success px-3 py-2 rounded-pill"><i class="fa-solid fa-check-circle me-1"></i>In Stock</span>
        </div>

        <div class="row g-3 mt-auto align-items-center">
            <div class="col-sm-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Quantity</label>
                <div class="input-group">
                    <button class="btn btn-modern-outline px-3" type="button" onclick="const q=document.getElementById('qty'); q.value=Math.max(1,parseInt(q.value)-1)">-</button>
                    <input type="text" id="qty" class="form-control form-control-modern text-center fw-bold" value="1" readonly>
                    <button class="btn btn-modern-outline px-3" type="button" onclick="const q=document.getElementById('qty'); q.value=parseInt(q.value)+1">+</button>
                </div>
            </div>
            <div class="col-sm-4 mt-4 mt-sm-0 pt-sm-4">
                <button class="btn btn-modern-outline w-100 fw-bold py-3" onclick="addToCart(@Model.Id)"><i class="fa-solid fa-cart-plus me-2"></i>Add to Cart</button>
            </div>
            <div class="col-sm-5 mt-3 mt-sm-0 pt-sm-4">
                <button class="btn btn-modern w-100 fw-bold py-3" onclick="window.location.href='/Checkout'"><i class="fa-solid fa-bolt me-2 text-warning"></i>Buy Now</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function addToCart(productId) {
            const qty = document.getElementById('qty').value;
            try {
                const response = await fetch('/Cart/Add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ productId: productId, quantity: parseInt(qty) })
                });

                if (response.ok) {
                    showToast('Success', 'Product added to cart successfully.');
                    if (typeof updateCartBadge === 'function') {
                        updateCartBadge();
                    }
                } else {
                    showToast('Error', 'Could not add item to cart. Please try again.', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Error', 'An unexpected error occurred.', 'error');
            }
        }
    </script>
}
