<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopSphere 2026</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Custom Modern CSS -->
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark navbar-modern glass py-3">
        <div class="container">
            <a class="navbar-brand navbar-brand-modern text-white d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-gem text-primary me-2 fs-3"></i>ShopSphere
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-toggle="collapse" data-bs-target="#navbarColor">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarColor">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-semibold">
                    <li class="nav-item">
                        <a class="nav-link nav-link-modern px-3" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-modern px-3" href="/?view=all">Shop</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-modern px-3" href="/Category">Categories</a>
                    </li>
                </ul>

                <form class="d-flex position-relative me-3" style="width: 250px;">
                    <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input class="form-control form-control-modern rounded-pill ps-5 bg-transparent" type="search" placeholder="Search products...">
                </form>

                <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                    <a asp-controller="Wishlist" asp-action="Index" class="btn btn-link text-white text-decoration-none p-0 position-relative">
                        <i class="fa-solid fa-heart fs-5"></i>
                    </a>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-link text-white text-decoration-none p-0 position-relative">
                        <i class="fa-solid fa-cart-shopping fs-5"></i>
                        <span class="cart-badge" id="cartBadge">0</span>
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="btn btn-modern-outline rounded-pill px-4 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fa-regular fa-user me-2"></i>@(User.Identity.Name?.Split('@')[0] ?? "Account")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end glass border-0 mt-3 shadow">
                                @if(User.IsInRole("Admin")) {
                                    <li><a class="dropdown-item text-white py-2" asp-controller="Admin" asp-action="Dashboard"><i class="fa-solid fa-shield-halved w-20 me-2 text-muted"></i> Admin Dashboard</a></li>
                                    <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                                } else {
                                    <li><a class="dropdown-item text-white py-2" asp-controller="User" asp-action="Dashboard"><i class="fa-solid fa-route w-20 me-2 text-muted"></i> My Orders</a></li>
                                    <li><a class="dropdown-item text-white py-2" asp-controller="Wishlist" asp-action="Index"><i class="fa-solid fa-heart w-20 me-2 text-muted"></i> Wishlist</a></li>
                                    <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                                }
                                <li><a class="dropdown-item text-white py-2" asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-right-from-bracket w-20 me-2 text-muted"></i> Logout</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-modern-outline rounded-pill px-4">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> Login
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="pb-5 mb-5 flex-grow-1 animate-fade-in mt-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="mt-auto py-5 glass border-top border-secondary border-opacity-10 position-relative z-3">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h4 class="fw-bold text-white mb-3"><i class="fa-solid fa-gem text-primary me-2"></i>ShopSphere</h4>
                    <p class="text-muted small">The ultimate 2026 destination for premium gadgets. Built meticulously with next-generation aesthetics.</p>
                </div>
                <div class="col-lg-2">
                    <h6 class="fw-bold text-white mb-3 text-uppercase small">Shop</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none small hover-primary">Smartphones</a></li>
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none small hover-primary">Laptops</a></li>
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none small hover-primary">Accessories</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6 class="fw-bold text-white mb-3 text-uppercase small">Support</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none small hover-primary">Order Tracking</a></li>
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none small hover-primary">Returns Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6 class="fw-bold text-white mb-3 text-uppercase small">Subscribe</h6>
                    <div class="input-group input-group-sm mb-3">
                        <input type="email" class="form-control form-control-modern border-0" placeholder="Email Address">
                        <button class="btn btn-modern px-3" type="button"><i class="fa-solid fa-paper-plane"></i></button>
                    </div>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-4">
            <div class="text-center text-muted small">
                &copy; 2026 ShopSphere E-commerce. Default Dark System Active.
            </div>
        </div>
    </footer>

    <!-- Toast Notification Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999; margin-top: 85px;">
        <div id="liveToast" class="toast glass text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-transparent text-white border-bottom border-secondary border-opacity-25 pb-2">
                <div id="toastIconContainer" class="rounded-circle bg-success p-1 me-2 d-flex align-items-center justify-content-center" style="width: 20px; height: 20px;">
                    <i id="toastIcon" class="fa-solid fa-check text-white" style="font-size: 0.6rem;"></i>
                </div>
                <strong class="me-auto" id="toastTitle">Success</strong>
                <small class="text-muted">Just now</small>
                <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body opacity-75" id="toastMessage">
                Action performed successfully.
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script>
        function showToast(title, message, type = 'success') {
            document.getElementById('toastTitle').textContent = title;
            document.getElementById('toastMessage').textContent = message;
            
            const iconContainer = document.getElementById('toastIconContainer');
            const icon = document.getElementById('toastIcon');
            
            if (type === 'error') {
                iconContainer.className = 'rounded-circle bg-danger p-1 me-2 d-flex align-items-center justify-content-center';
                icon.className = 'fa-solid fa-xmark text-white';
            } else {
                iconContainer.className = 'rounded-circle bg-success p-1 me-2 d-flex align-items-center justify-content-center';
                icon.className = 'fa-solid fa-check text-white';
            }

            const toastElList = [].slice.call(document.querySelectorAll('.toast'));
            const toastList = toastElList.map(function(toastEl) {
                return new bootstrap.Toast(toastEl, { delay: 3500 });
            });
            toastList.forEach(toast => toast.show());
        }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            updateCartBadge();
        });

        async function updateCartBadge() {
            try {
                const response = await fetch('/Cart/GetCartCount');
                if (response.ok) {
                    const data = await response.json();
                    const badge = document.getElementById('cartBadge');
                    if (badge) {
                        badge.textContent = data.count > 0 ? data.count : '0';
                    }
                }
            } catch (error) {
                console.error('Error fetching cart count:', error);
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
