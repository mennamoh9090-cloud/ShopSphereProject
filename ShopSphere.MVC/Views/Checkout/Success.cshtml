@{
    ViewData["Title"] = "Payment Successful";
}

<div class="row justify-content-center mt-5 mb-5 animate-slide-up">
    <div class="col-lg-6 col-md-8 text-center">
        <div class="card card-modern border-0 p-5 position-relative overflow-hidden">
            <!-- Background Glow -->
            <div class="position-absolute ms-5 mt-5" style="width: 300px; height: 300px; background: radial-gradient(circle, rgba(34,197,94,0.15) 0%, transparent 70%); top: -50px; left: -50px; border-radius: 50%; z-index: 0;"></div>
            
            <div class="position-relative z-1">
                <!-- Success Checkmark -->
                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 100px; height: 100px; background: linear-gradient(135deg, rgba(34,197,94,0.2), rgba(34,197,94,0.05)); border: 2px solid var(--success); box-shadow: 0 0 30px rgba(34,197,94,0.3);">
                    <i class="fa-solid fa-check text-success" style="font-size: 3rem;"></i>
                </div>
                
                <h2 class="display-6 fw-bold text-white mb-2">Payment Successful!</h2>
                <p class="text-muted mb-5">Your secure transaction was processed via Stripe securely. Thank you for shopping with ShopSphere.</p>
                
                <!-- Receipt Card -->
                <div class="card border-0 bg-dark bg-opacity-50 text-start p-4 mb-5 rounded-4 border border-secondary border-opacity-25 shadow-sm">
                    <h6 class="text-muted text-uppercase small fw-bold mb-3 ls-1">Transaction Receipt</h6>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Order Number</span>
                        <span class="text-white fw-bold">#ORD-2026-X91</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Date & Time</span>
                        <span class="text-white fw-bold">@DateTime.Now.ToString("dd MMM yyyy, HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Payment Method</span>
                        <span class="text-white fw-bold"><i class="fa-brands fa-cc-visa me-2"></i>•••• 4242</span>
                    </div>
                    
                    <hr class="border-secondary opacity-50 my-3">
                    
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted fs-6">Amount Paid</span>
                        <span class="text-success fw-bold fs-4">$622.50</span>
                    </div>
                </div>
                
                <div class="d-grid gap-3">
                    <a href="/User/Dashboard" class="btn btn-modern btn-lg fw-bold shadow-glow text-white text-decoration-none py-3">Track My Order <i class="fa-solid fa-route ms-2"></i></a>
                    <a href="/" class="btn btn-modern-outline btn-lg fw-bold text-decoration-none py-3">Continue Shopping</a>
                </div>
            </div>
        </div>
    </div>
</div>
