@{
    ViewData["Title"] = "Payment Failed";
}

<div class="row justify-content-center my-5 py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card card-modern p-5 border-0">
            <div class="d-inline-flex justify-content-center align-items-center rounded-circle bg-danger bg-opacity-10 text-danger mb-4 mx-auto" style="width: 100px; height: 100px;">
                <i class="fa-solid fa-xmark fs-1"></i>
            </div>
            
            <h1 class="display-6 fw-bold mb-3">Payment Failed</h1>
            <p class="lead text-muted mb-4">We couldn't process your payment. Please ensure your card details are correct or try a different payment method.</p>
            
            <div class="bg-light rounded p-4 mb-4">
                <p class="mb-0 text-dark fw-bold"><i class="fa-solid fa-circle-exclamation text-danger me-2"></i> Error Code: ERR_DECLINED_P2026</p>
            </div>
            
            <div class="d-flex gap-3 justify-content-center">
                <a asp-controller="Checkout" asp-action="Index" class="btn btn-modern px-4 py-2">Try Again</a>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-modern-outline px-4 py-2">Return to Cart</a>
            </div>
        </div>
    </div>
</div>
