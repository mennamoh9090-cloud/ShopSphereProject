@model ShopSphere.MVC.Models.ProductViewModel
@{
    ViewData["Title"] = "Add Product | Admin";
    var categories = ViewBag.Categories as IEnumerable<ShopSphere.MVC.Models.CategoryViewModel>;
}

<div class="row mt-4 animate-slide-up">
    <!-- Sidebar -->
    <div class="col-lg-3 mb-4">
        <div class="card card-modern p-4 text-center border-0 border-bottom border-danger border-4">
            <div class="rounded-circle bg-dark border border-secondary d-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 80px; height: 80px;">
                <i class="fa-solid fa-shield-halved fs-1 text-danger"></i>
            </div>
            <h5 class="fw-bold text-danger">Root Administrator</h5>
            <p class="text-muted small">@User.Identity?.Name</p>
            <hr class="border-secondary opacity-25">
            <div class="d-grid gap-2 text-start">
                <a href="/Admin/Dashboard" class="btn btn-modern-outline fw-bold text-start border-0 text-white d-block w-100 text-decoration-none"><i class="fa-solid fa-chart-pie w-20 text-center me-2 text-muted"></i>Overview System</a>
                <a href="/Admin/ManageProducts" class="btn btn-modern fw-bold text-start d-block w-100 text-decoration-none"><i class="fa-solid fa-box w-20 text-center me-2"></i>Manage Products</a>
                <a href="/Admin/Categories" class="btn btn-modern-outline fw-bold text-start border-0 text-white d-block w-100 text-decoration-none"><i class="fa-solid fa-layer-group w-20 text-center me-2 text-muted"></i>Categories</a>
                <a href="/Admin/Users" class="btn btn-modern-outline fw-bold text-start border-0 text-white d-block w-100 text-decoration-none"><i class="fa-solid fa-users-gear w-20 text-center me-2 text-muted"></i>User Accounts</a>
                <a href="/Admin/Orders" class="btn btn-modern-outline fw-bold text-start border-0 text-white d-block w-100 text-decoration-none"><i class="fa-solid fa-truck-fast w-20 text-center me-2 text-muted"></i>Manage Orders</a>
                <a href="/Account/Logout" class="btn btn-outline-danger mt-3 fw-bold"><i class="fa-solid fa-right-from-bracket w-20 text-center me-2"></i>Exit Interface</a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold text-white"><i class="fa-solid fa-plus me-2 text-primary"></i>Add New Product</h3>
            <a href="/Admin/ManageProducts" class="btn btn-modern-outline fw-bold px-4 border-0 text-white"><i class="fa-solid fa-arrow-left me-2"></i>Back</a>
        </div>

        <div class="card card-modern border-0">
            <div class="card-body p-4">
                <form asp-action="AddProduct" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-white">Product Name</label>
                            <input asp-for="Name" class="form-control form-control-modern" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white">Category</label>
                            <select asp-for="CategoryId" class="form-select form-control-modern" required>
                                <option value="">Select Category...</option>
                                @if(categories != null)
                                {
                                    foreach(var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white">Price</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control form-control-modern" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white">Stock Quantity</label>
                            <input asp-for="Stock" type="number" class="form-control form-control-modern" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-white">Image URL</label>
                            <input asp-for="ImageUrl" class="form-control form-control-modern" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-white">Description</label>
                            <textarea asp-for="Description" class="form-control form-control-modern" rows="4" required></textarea>
                        </div>
                        <div class="col-12 mt-4 text-end">
                            <button type="submit" class="btn btn-modern px-5 fw-bold"><i class="fa-solid fa-save me-2"></i>Save Product</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
