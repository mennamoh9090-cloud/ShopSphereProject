@model IEnumerable<ShopSphere.MVC.Models.OrderViewModel>
@{
    ViewData["Title"] = "Manage Orders | Admin";
}

<div class="row mt-4 animate-slide-up">
    <!-- Sidebar -->
    <div class="col-lg-3 mb-4">
        <div class="card card-modern p-4 text-center border-0 border-bottom border-danger border-4">
            <div class="rounded-circle bg-dark border border-secondary d-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 80px; height: 80px;">
                <i class="fa-solid fa-shield-halved fs-1 text-danger"></i>
            </div>
            <h5 class="fw-bold text-danger">Root Administrator</h5>
            <p class="text-muted small">@User.Identity?.Name</p>
            <hr class="border-secondary opacity-25">
            <div class="d-grid gap-2 text-start">
                <a href="/Admin/Dashboard" class="btn btn-modern-outline fw-bold text-start border-0 text-white d-block w-100 text-decoration-none"><i class="fa-solid fa-chart-pie w-20 text-center me-2 text-muted"></i>Overview System</a>
                <a href="/Admin/ManageProducts" class="btn btn-modern-outline fw-bold text-start border-0 text-white d-block w-100 text-decoration-none"><i class="fa-solid fa-box w-20 text-center me-2 text-muted"></i>Manage Products</a>
                <a href="/Admin/Categories" class="btn btn-modern-outline fw-bold text-start border-0 text-white d-block w-100 text-decoration-none"><i class="fa-solid fa-layer-group w-20 text-center me-2 text-muted"></i>Categories</a>
                <a href="/Admin/Users" class="btn btn-modern-outline fw-bold text-start border-0 text-white d-block w-100 text-decoration-none"><i class="fa-solid fa-users-gear w-20 text-center me-2 text-muted"></i>User Accounts</a>
                <a href="/Admin/Orders" class="btn btn-modern fw-bold text-start d-block w-100 text-decoration-none"><i class="fa-solid fa-truck-fast w-20 text-center me-2"></i>Manage Orders</a>
                <a href="/Account/Logout" class="btn btn-outline-danger mt-3 fw-bold"><i class="fa-solid fa-right-from-bracket w-20 text-center me-2"></i>Exit Interface</a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold text-white"><i class="fa-solid fa-truck-fast me-2 text-primary"></i>Manage Orders</h3>
        </div>

        <div class="card card-modern border-0">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle bg-transparent mb-0">
                        <thead class="text-muted small text-uppercase border-bottom border-secondary">
                            <tr>
                                <th class="bg-transparent text-muted">Order ID</th>
                                <th class="bg-transparent text-muted">Customer</th>
                                <th class="bg-transparent text-muted">Date</th>
                                <th class="bg-transparent text-muted">Total</th>
                                <th class="bg-transparent text-muted">Payment</th>
                                <th class="bg-transparent text-muted text-end">Order Status</th>
                                <th class="bg-transparent text-muted text-center">Details</th>
                            </tr>
                        </thead>
                        <tbody class="border-secondary opacity-75">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var o in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-white bg-transparent">#ORD-@o.Id.ToString("D5")</td>
                                        <td class="bg-transparent text-info small">@o.UserId</td>
                                        <td class="bg-transparent">@o.CreatedAt.ToString("g")</td>
                                        <td class="fw-bold text-success bg-transparent">$@o.TotalPrice.ToString("F2")</td>
                                        <td class="bg-transparent">
                                            <span class="badge @(o.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">@o.PaymentStatus</span>
                                        </td>
                                        <td class="text-end bg-transparent">
                                            <form method="post" action="/Admin/UpdateOrderStatus" class="d-inline-flex">
                                                <input type="hidden" name="id" value="@o.Id" />
                                                <select name="status" class="form-select form-select-sm bg-dark text-white border-secondary me-2 w-auto" onchange="this.form.submit()">
                                                    <option value="Pending" selected="@(o.OrderStatus == "Pending")">Pending</option>
                                                    <option value="Processing" selected="@(o.OrderStatus == "Processing")">Processing / Accepted</option>
                                                    <option value="Shipped" selected="@(o.OrderStatus == "Shipped")">Shipped</option>
                                                    <option value="Delivered" selected="@(o.OrderStatus == "Delivered")">Delivered</option>
                                                </select>
                                            </form>
                                        </td>
                                        <td class="text-center bg-transparent">
                                            <button type="button" class="btn btn-sm btn-modern-outline" onclick="loadOrderDetails(@o.Id)">View</button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="bg-transparent text-center text-muted py-4">No orders found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

<!-- Generic Order Details Modal Container -->
<div class="modal fade" id="orderModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content card-modern border-0 shadow-lg bg-dark" style="background-color: #1e1e2d !important;">
            
            <div class="modal-header border-secondary border-opacity-25 pb-3">
                <h5 class="modal-title fw-bold text-white"><i class="fa-solid fa-box text-primary me-2"></i><span id="orderModalTitleText">Order Details</span></h5>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" onclick="if(window.modalInstance){window.modalInstance.hide();}else{document.getElementById('orderModal').style.display='none';document.getElementById('orderModal').classList.remove('show');document.body.classList.remove('modal-open');document.body.style='';document.querySelectorAll('.modal-backdrop').forEach(e=>e.remove());}"></button>
            </div>

            <div class="modal-body p-4 text-start" id="orderModalContent">
                <!-- Dynamic body content injected here -->
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.modalInstance = null;
        window.isFetching = false;

        async function loadOrderDetails(orderId) {
            if (window.isFetching) return;
            window.isFetching = true;

            const modalEl = document.getElementById('orderModal');
            if (window.modalInstance) {
                window.modalInstance.dispose();
            }
            window.modalInstance = new bootstrap.Modal(modalEl, {
                backdrop: 'static',
                keyboard: false
            });
            window.modalInstance.show();
            
            // Set loading state safely inside Body
            document.getElementById('orderModalContent').innerHTML = '<div class="text-center p-5"><div class="spinner-border text-primary mb-3" role="status"></div><p class="text-white mt-3">Loading order details...</p></div>';
            document.getElementById('orderModalTitleText').innerText = 'Order Details';

            try {
                const response = await fetch(`/Admin/GetOrderDetailsPartial?id=${orderId}`);
                if (response.ok) {
                    const html = await response.text();
                    // Injecting into modal body only! Buttons are safely static outside this dive.
                    document.getElementById('orderModalContent').innerHTML = html;
                    
                    // Script execution hack for dynamically loaded script tags via innerHTML
                    const scripts = document.getElementById('orderModalContent').querySelectorAll('script');
                    scripts.forEach(script => {
                        const newScript = document.createElement('script');
                        newScript.text = script.text;
                        document.body.appendChild(newScript).parentNode.removeChild(newScript);
                    });

                } else {
                    document.getElementById('orderModalContent').innerHTML = '<div class="text-center p-5"><p class="text-danger">Failed to load details. Please try again.</p></div>';
                }
            } catch (err) {
                console.error(err);
                document.getElementById('orderModalContent').innerHTML = '<div class="text-center p-5"><p class="text-danger">A network error occurred.</p></div>';
            } finally {
                window.isFetching = false;
            }
        }
    </script>
}
